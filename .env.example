ANTHROPIC_API_KEY=sk-ant-...
# Optional: a different model for the advice (default claude-haiku-5-5)
# PBA_MODEL=claude-sonnet-5
# Optional: level the team evenly toward this level (e.g. the next boss / level cap)
# PBA_TARGET_LEVEL=38
# Optional: Nuzlocke mode, which makes the advice avoid any KO risk (fainted = gone)
# PBA_NUZLOCKE=1
# Optional: a stronger model just for gym leader / Champion battles
# PBA_BOSS_MODEL=claude-sonnet-5
